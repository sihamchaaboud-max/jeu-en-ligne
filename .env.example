# ===========================================
# Copiez ce fichier en .env et remplissez les valeurs
# NE commitez JAMAIS le fichier .env réel
# ===========================================

MONGO_URL=mongodb://localhost:27017
MONGO_DB=jeu_en_ligne

REDIS_URL=redis://localhost:6379/0

NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGEZ_MOI

# Générez avec : openssl rand -hex 32
JWT_SECRET=CHANGEZ_MOI_AVEC_UNE_CLE_ALEATOIRE_LONGUE
JWT_EXPIRE_MINUTES=720

# Clé d'administration (définit / change le mot de passe de n'importe quel joueur)
# Générez avec : openssl rand -hex 32   — vide = opérations admin désactivées
ADMIN_TOKEN=

QUIZ_PARTIE_TTL=600
